# Domínio público da sala (o Caddy tira o certificado sozinho; o DNS precisa apontar para o servidor).
TELA_DOMINIO=tela.exemplo.com

# Senha única da sala, compartilhada com quem vai entrar.
TELA_PASSWORD=troque-isto

# Senha do administrador (convites temporários, desbloqueio de IP). Vazia desliga os convites.
TELA_ADMIN_PASSWORD=
